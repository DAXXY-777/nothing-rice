* {
    background:     #000000cc;        /* semi-transparent black */
    background-alt: #1a1a1acc;        /* slightly lighter black */
    foreground:     #ffffffcc;        /* soft white text */
    selected:       #ff003cff;        /* Nothing Phone accent red */
    active:         #ff3366ff;        /* slightly brighter for active */
    urgent:         #ff5555ff;        /* softer red for urgent items */
}

